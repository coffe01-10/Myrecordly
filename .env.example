# Optional legacy services only. Cloud drive login does not need Supabase.
# Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Publishers can bundle public/google-oauth-desktop.json for Google Drive.
# End users never need to create or import developer credentials.

# Leave blank until the hosted recording service is deployed and verified.
# Development defaults to localhost:8787; packaged builds require an explicit URL.
VITE_CLOUD_SHARE_ENDPOINT=
